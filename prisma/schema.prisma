generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  image       String?
  heroImage   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mainGroup   String?  @default("inflatableBoats")
  models      Model[]
}

model Model {
  id                  Int               @id @default(autoincrement())
  categoryId          Int
  name                String
  description         String?
  shortDescription    String?
  imageFile           String?
  heroImageFile       String?
  contentImageFile    String?
  section2Title       String?
  section2Description String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  interiorMainImage   String?
  features            Feature[]
  galleryImages       GalleryImage[]
  interiorFiles       InteriorFile[]
  category            Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionalFeatures    OptionalFeature[]
  specs               Spec[]
  videoFiles          VideoFile[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Spec {
  id        Int      @id @default(autoincrement())
  modelId   Int
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, key])
  @@index([modelId])
}

model Feature {
  id        Int      @id @default(autoincrement())
  modelId   Int
  feature   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model OptionalFeature {
  id          Int      @id @default(autoincrement())
  modelId     Int
  name        String
  description String?
  category    String?
  price       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  model       Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  modelId   Int
  filename  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model VideoFile {
  id        Int      @id @default(autoincrement())
  modelId   Int
  filename  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model InteriorFile {
  id        Int      @id @default(autoincrement())
  modelId   Int
  filename  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id               Int      @id @default(autoincrement())
  type             String
  name             String
  email            String
  phone            String?
  subject          String?
  message          String?
  modelName        String?
  selectedColors   String?
  selectedFeatures String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([type])
  @@index([createdAt])
}

model Event {
  id          Int       @id @default(autoincrement())
  name        String
  location    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  image       String?
  website     String?
  status      String    @default("upcoming")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([order])
}

model Dealer {
  id        Int      @id @default(autoincrement())
  company   String
  country   String
  address   String?
  telephone String?
  fax       String?
  email     String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([company])
  @@index([country])
}
